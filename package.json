{
  "name": "bunql",
  "version": "0.1.0-alpha.0",
  "description": "Lightweight SQLite wrapper for Bun with queued writes, serialized transactions, and SQLITE_BUSY handling",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "bench": "bun run bench/runner.ts",
    "prepublishOnly": "bun run lint && bun run typecheck && bun test"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "bun",
    "sqlite",
    "wrapper",
    "lightweight",
    "concurrency",
    "queue"
  ],
  "license": "MIT"
}
