{
  "name": "@nds-stack/bunql",
  "version": "0.2.0",
  "description": "Lightweight SQLite wrapper for Bun — queued writes, serialized transactions, SQLITE_BUSY handling",
  "author": "nds-stack <nds.stack@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json",
    "bench": "bun run bench/runner.ts",
    "prepublishOnly": "bun run lint && bun run typecheck && bun test && bun run build",
    "build": "bun run clean && bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --external bun:sqlite && bun build ./src/server/index.ts --outdir=./dist/server --target=bun --format=esm --external bun:sqlite && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nds-stack/bunql.git"
  },
  "bugs": {
    "url": "https://github.com/nds-stack/bunql/issues"
  },
  "homepage": "https://github.com/nds-stack/bunql#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yocto-queue": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/sql.js": "^1.4.11",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.3.0",
    "sql.js": "^1.14.1",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "bun",
    "sqlite",
    "bun-sqlite",
    "database",
    "wrapper",
    "concurrency",
    "queue",
    "transaction",
    "sqlite-busy",
    "wal",
    "typescript"
  ],
  "license": "MIT"
}
